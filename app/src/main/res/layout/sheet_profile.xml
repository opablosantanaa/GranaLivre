<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <include layout="@layout/include_sheet_header" />

        <TextView
            android:id="@+id/email"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/SheetLabel"
            android:text="@string/profile_appearance" />

        <com.opablosantanaa.granalivre.ui.widget.SegmentedControl
            android:id="@+id/theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/SheetLabel"
            android:layout_marginBottom="0dp"
            android:text="@string/profile_accounts" />

        <LinearLayout
            android:id="@+id/accounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_account"
            style="@style/Button.GranaLivre.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:text="@string/profile_add_account"
            app:icon="@drawable/ic_plus"
            app:iconSize="18dp"
            app:iconTint="@color/gl_primary" />

        <TextView
            style="@style/SheetLabel"
            android:layout_marginBottom="0dp"
            android:text="@string/profile_cards" />

        <LinearLayout
            android:id="@+id/cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_card"
            style="@style/Button.GranaLivre.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:text="@string/profile_add_card"
            app:icon="@drawable/ic_plus"
            app:iconSize="18dp"
            app:iconTint="@color/gl_primary" />

        <TextView
            style="@style/SheetLabel"
            android:layout_marginBottom="0dp"
            android:text="@string/profile_categories" />

        <TextView
            android:id="@+id/categories_count"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_category"
            style="@style/Button.GranaLivre.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:text="@string/profile_add_category"
            app:icon="@drawable/ic_plus"
            app:iconSize="18dp"
            app:iconTint="@color/gl_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/demo"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/schibsted_semibold"
            android:letterSpacing="0"
            android:text="@string/profile_demo"
            android:textAllCaps="false"
            android:textColor="@color/gl_text"
            android:visibility="gone"
            app:cornerRadius="26dp"
            app:strokeColor="@color/gl_line" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
