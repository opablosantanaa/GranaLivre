<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".App">

    <com.opablosantanaa.granalivre.ui.prism.PrismView
        android:id="@+id/prism"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/prism_veil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_prism_veil"
        android:importantForAccessibility="no" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/tabbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/bg_tabbar"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">

        <include
            android:id="@+id/tab_home"
            layout="@layout/item_tab"
            android:layout_width="48dp"
            android:layout_height="48dp" />

        <include
            android:id="@+id/tab_moves"
            layout="@layout/item_tab"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp" />

        <include
            android:id="@+id/tab_recurring"
            layout="@layout/item_tab"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp" />

        <include
            android:id="@+id/tab_analytics"
            layout="@layout/item_tab"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp" />

        <include
            android:id="@+id/tab_goals"
            layout="@layout/item_tab"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>
</FrameLayout>
