<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:id="@+id/identity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/home_profile"
                android:minHeight="48dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/name"
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/gl_on_silk" />

                <TextView
                    android:id="@+id/today"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/gl_on_silk_secondary" />
            </LinearLayout>

            <com.opablosantanaa.granalivre.ui.widget.CoinView
                android:id="@+id/advisor"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/advisor_open"
                android:focusable="true"
                android:padding="4dp" />

            <ImageButton
                android:id="@+id/add_card"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/home_add_card"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_card"
                app:tint="@color/gl_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/advisor_bubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_surface"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/advisor_title"
                    style="@style/Text.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/schibsted_semibold"
                    android:text="@string/advisor_title"
                    android:textColor="@color/gl_primary" />

                <ImageButton
                    android:id="@+id/advisor_close"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/advisor_close"
                    android:src="@drawable/ic_close"
                    app:tint="@color/gl_text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/advisor_text"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/gl_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/advisor_next"
                style="@style/Button.GranaLivre.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="@string/advisor_next" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/balance_title"
                    style="@style/Text.Headline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/card_total"
                    android:textColor="#1A2B2E" />

                <TextView
                    android:id="@+id/period"
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_period_chip"
                    android:drawablePadding="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#1A2B2E"
                    app:drawableEndCompat="@drawable/ic_calendar"
                    app:drawableTint="#1A2B2E" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/balance_pager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:overScrollMode="never" />

            <LinearLayout
                android:id="@+id/balance_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:importantForAccessibility="no"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/delta"
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#3F5558" />

            <TextView
                android:id="@+id/bar_caption"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="#3F5558" />

            <com.opablosantanaa.granalivre.ui.widget.PairBarsView
                android:id="@+id/bars"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/legend_income"
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="6dp"
                    android:text="@string/home_legend_income"
                    android:textColor="#3F5558"
                    app:drawableStartCompat="@drawable/bg_dot_legend" />

                <TextView
                    android:id="@+id/legend_expense"
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:drawablePadding="6dp"
                    android:text="@string/home_legend_expense"
                    android:textColor="#3F5558"
                    app:drawableStartCompat="@drawable/bg_dot_legend" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:id="@+id/action_income"
                style="@style/HomeAction"
                android:background="@drawable/bg_action_fill">

                <ImageView
                    style="@style/HomeAction.Icon"
                    android:src="@drawable/ic_arrow_in"
                    app:tint="#0E1416" />

                <TextView
                    style="@style/HomeAction.Label"
                    android:text="@string/home_income"
                    android:textColor="#0E1416" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_expense"
                style="@style/HomeAction"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_action_light">

                <ImageView
                    style="@style/HomeAction.Icon"
                    android:src="@drawable/ic_arrow_out"
                    app:tint="@color/gl_expense" />

                <TextView
                    style="@style/HomeAction.Label"
                    android:text="@string/home_expense"
                    android:textColor="@color/gl_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_transfer"
                style="@style/HomeAction"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_action_ghost">

                <ImageView
                    style="@style/HomeAction.Icon"
                    android:src="@drawable/ic_swap"
                    app:tint="@color/gl_on_silk" />

                <TextView
                    style="@style/HomeAction.Label"
                    android:text="@string/home_transfer"
                    android:textColor="@color/gl_on_silk" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/import_statement"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/schibsted_semibold"
            android:letterSpacing="0"
            android:text="@string/import_button"
            android:textAllCaps="false"
            android:textColor="@color/gl_on_silk"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_import"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="@color/gl_on_silk"
            app:strokeColor="@color/gl_on_silk_line" />

        <LinearLayout
            android:id="@+id/warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_warn"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_alert"
                app:tint="@color/gl_accent" />

            <TextView
                android:id="@+id/warning_text"
                style="@style/Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="@color/gl_on_silk" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <include
                android:id="@+id/tile_income"
                layout="@layout/item_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/tile_expense"
                layout="@layout/item_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <include
                android:id="@+id/tile_card"
                layout="@layout/item_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/tile_fixed"
                layout="@layout/item_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_tile"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/heatmap_title" />

            <TextView
                android:id="@+id/heatmap_caption"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/heatmap_hint" />

            <com.opablosantanaa.granalivre.ui.widget.HeatmapView
                android:id="@+id/heatmap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <LinearLayout
                android:id="@+id/heatmap_legend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="@string/heatmap_more_expense" />

                <LinearLayout
                    android:id="@+id/heatmap_swatches"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/heatmap_more_income" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sheet"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sheet"
            android:minHeight="240dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Headline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_recent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/see_all"
                    style="@style/Button.GranaLivre.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="-12dp"
                    android:text="@string/home_see_all" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/empty"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/gl_text_secondary"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/empty_action"
                style="@style/Button.GranaLivre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
