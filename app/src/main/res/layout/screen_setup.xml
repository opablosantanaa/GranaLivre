<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="-10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/gl_on_silk" />

            <!-- empurra a conversa para perto do formulário, como num chat; o espaço ganha selos flutuando -->
            <FrameLayout
                android:id="@+id/setup_sky"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:minHeight="24dp" />

            <!-- Mascote conversando: o balão muda conforme a pessoa preenche o cadastro -->
            <FrameLayout
                android:id="@+id/setup_stage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipChildren="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:background="@drawable/bg_pedestal_ring">

                        <com.opablosantanaa.granalivre.ui.widget.CoinView
                            android:id="@+id/mascot"
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/bubble"
                        style="@style/Text.Body.Strong"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:accessibilityLiveRegion="polite"
                        android:background="@drawable/bg_speech"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp"
                        android:text="@string/setup_title"
                        android:textColor="#0E1416"
                        android:textSize="17sp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/setup_caption"
                android:textColor="@color/gl_on_silk_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sheet"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/SetupField.Label"
                android:labelFor="@id/name"
                android:text="@string/field_name" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/name_layout"
                style="@style/SetupField"
                android:layout_marginBottom="18dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/name"
                    style="@style/SetupField.Input"
                    android:hint="@string/setup_name_placeholder"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="60" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/SetupField.Label"
                android:labelFor="@id/birth"
                android:text="@string/field_birth" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/birth_layout"
                style="@style/SetupField"
                android:layout_marginBottom="20dp"
                app:endIconContentDescription="@string/setup_birth_pick"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/birth"
                    style="@style/SetupField.Input"
                    android:cursorVisible="false"
                    android:hint="@string/setup_birth_placeholder"
                    android:focusable="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/error"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="@color/gl_expense"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/submit"
                style="@style/Button.GranaLivre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_submit" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/setup_legal"
                android:textColor="@color/gl_text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/terms"
                    style="@style/Button.GranaLivre.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/legal_terms" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/privacy"
                    style="@style/Button.GranaLivre.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/legal_privacy" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
